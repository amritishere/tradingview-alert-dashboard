{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tradingview-alert-dashboard",
  "compatibility_date": "2026-08-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": false
}
